# Your store's *.myshopify.com domain. Custom domains are NOT accepted by the
# Admin API. A bare handle like "my-store" is expanded to "my-store.myshopify.com".
SHOPIFY_STORE_DOMAIN=my-store.myshopify.com

# Admin API access token from a custom app:
#   Settings -> Apps and sales channels -> Develop apps -> (your app)
#   -> API credentials -> Admin API access token
# Starts with "shpat_". Grant at least read_products; add read_inventory and
# read_locations for the inventory tools.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Admin GraphQL API version (optional). Defaults to 2026-04.
SHOPIFY_API_VERSION=2026-04

# Max retries on rate-limit / throttle responses (optional). Defaults to 3.
SHOPIFY_MAX_RETRIES=3

# Set to "1" to log debug output to stderr (optional).
SHOPIFY_DEBUG=
