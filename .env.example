# Your store's *.myshopify.com domain. Custom domains are NOT accepted by the
# Admin API. A bare handle like "my-store" is expanded to "my-store.myshopify.com".
SHOPIFY_STORE_DOMAIN=my-store.myshopify.com

# App credentials from the Shopify Dev Dashboard (https://dev.shopify.com):
#   Apps -> (your app) -> API credentials
# The app must be INSTALLED on the store above. The server exchanges these for a
# short-lived access token via the OAuth client_credentials grant and auto-refreshes
# it. The token carries exactly the scopes the app declares in the Dev Dashboard, so
# to add capability you edit the app's scopes there and reinstall — no code change.
#
# ── Access scopes ────────────────────────────────────────────────────────────
# Shopify has NO wildcard / "full admin" scope: every capability is a separate
# read_*/write_* scope you must enumerate. Full list + which are approval-gated:
#   https://shopify.dev/docs/api/usage/access-scopes
#
#   Read-only (what this server ships with today):
#     read_products                 — required, minimum
#     read_inventory, read_locations — for the inventory tools
#
#   Writes (needed by the planned write tools, e.g. set_metafield/update_product):
#     write_products                — metafields + product mutations
#     write_inventory               — if/when inventory writes are added
#
#   Full admin control (single store): enumerate every scope. Paste-ready set of
#   all non-approval scopes (drop any you don't want; the 4 approval-gated ones —
#   read_all_orders, read_customer_payment_methods, read/write_own_subscription_contracts
#   — must be requested separately and are omitted):
#     read_products,write_products,read_inventory,write_inventory,
#     read_locations,write_locations,read_orders,write_orders,
#     read_draft_orders,write_draft_orders,read_order_edits,write_order_edits,
#     read_fulfillments,write_fulfillments,read_assigned_fulfillment_orders,
#     write_assigned_fulfillment_orders,read_merchant_managed_fulfillment_orders,
#     write_merchant_managed_fulfillment_orders,read_third_party_fulfillment_orders,
#     write_third_party_fulfillment_orders,read_marketplace_fulfillment_orders,
#     read_customers,write_customers,read_customer_merge,write_customer_merge,
#     read_customer_events,read_discounts,write_discounts,read_price_rules,
#     write_price_rules,read_payment_terms,write_payment_terms,read_content,
#     write_content,read_themes,write_themes,read_script_tags,write_script_tags,
#     read_files,write_files,read_metaobjects,write_metaobjects,
#     read_metaobject_definitions,write_metaobject_definitions,read_translations,
#     write_translations,read_locales,write_locales,read_markets,write_markets,
#     read_shipping,write_shipping,read_returns,write_returns,read_gift_cards,
#     write_gift_cards,read_marketing_events,write_marketing_events,
#     read_purchase_options,write_purchase_options,read_payment_customizations,
#     write_payment_customizations,read_delivery_customizations,
#     write_delivery_customizations,read_cart_transforms,write_cart_transforms,
#     read_validations,write_validations,read_checkout_branding_settings,
#     write_checkout_branding_settings,read_reports,read_legal_policies,
#     read_store_credit_accounts,read_store_credit_account_transactions,
#     write_store_credit_account_transactions
#
# Note on app type: this server is built around the client_credentials grant
# (Dev Dashboard app). A store-admin "custom app" (Settings -> Apps -> Develop
# apps) instead issues a long-lived shpat_ token directly and would NOT use this
# grant — adopting it would require rewriting src/client/auth.ts. For full admin
# on a single store, prefer expanding the existing app's scopes over switching.
SHOPIFY_CLIENT_ID=
# Client secret, starts with "shpss_".
SHOPIFY_CLIENT_SECRET=

# Admin GraphQL API version (optional). Defaults to 2026-04.
SHOPIFY_API_VERSION=2026-04

# Max retries on rate-limit / throttle / 401 responses (optional). Defaults to 3.
SHOPIFY_MAX_RETRIES=3

# Set to "1" to log debug output to stderr (optional).
SHOPIFY_DEBUG=
